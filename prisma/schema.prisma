generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Usuario {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  nombre         String
  email          String?   // opcional, sin @unique
  password       String

  rangoId        String?  @db.ObjectId
  rango          Rango?   @relation(fields: [rangoId], references: [id])

  nombreApellido String?  // campo opcional para nombre completo de la persona
}

model Rango {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  nombre    String    @unique
  reglas    Json?
  creadoEn  DateTime  @default(now())

  usuarios  Usuario[]
}

model Trampa {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  numero    Int?
  direccion String
  lat       Float
  lng       Float
  ubicacion String?  
  creadoEn  DateTime  @default(now())

  informes  Informe[]
}

model Informe {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  numero            Int?
  fecha             DateTime
  grupo             String
  hora              String?
  ronda             String?
  operadorId        String?  @db.ObjectId
  ubicacion         String?
  clima             String?
  fumigacion        String?
  estadoDispositivo String?
  estadoEnvase      String?

  anopheles         String   // "positivo" | "negativo"
  aedes             String   // "positivo" | "negativo"
  culex             String   // "positivo" | "negativo"

  ovitrapPositiva   String   // "si" | "no"
  larvasPupas       String   // "si" | "no"
  emergenciaAdultos String   // "si" | "no"
  cantidadAdultos   Int?

  creadoEn          DateTime @default(now())

  trampaId          String   @db.ObjectId
  trampa            Trampa   @relation(fields: [trampaId], references: [id])

  @@unique([trampaId, fecha])   // evita duplicados en la misma dirección y fecha
}
