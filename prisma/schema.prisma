generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Usuario {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  nombre         String
  email          String?   // 👈 opcional, sin @unique
  password       String
  creadoEn       DateTime @default(now())

  rangoId        String?  @db.ObjectId
  rango          Rango?   @relation(fields: [rangoId], references: [id])

  nombreApellido String?  // 👈 campo opcional para nombre completo de la persona
}

model Rango {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  nombre    String    @unique
  reglas    Json?
  creadoEn  DateTime  @default(now())

  usuarios  Usuario[]
}

model Trampa {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  direccion String
  lat       Float
  lng       Float
  ubicacion String?   // 👈 campo opcional para descripción de la ubicación
  creadoEn  DateTime  @default(now())

  informes  Informe[]
}

model Informe {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  fecha      DateTime
  tipos      Json      // guarda ["ovi","adultos"] como JSON
  cantidades Json      // { ovi: { Culex: 3 }, adultos: { Aedes: 4 } }
  notas      String?
  creadoEn   DateTime  @default(now())

  trampaId   String    @db.ObjectId
  trampa     Trampa    @relation(fields: [trampaId], references: [id])

  @@unique([trampaId, fecha])   // ✅ evita duplicados en la misma dirección y fecha
}
