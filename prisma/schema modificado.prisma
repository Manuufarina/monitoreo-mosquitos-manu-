generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  nombre    String
  email     String?  @unique
  password  String
  creadoEn  DateTime @default(now())

  rangoId   String?  @db.ObjectId
  rango     Rango?   @relation(fields: [rangoId], references: [id])
}

model Rango {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  nombre    String    @unique
  reglas    Json?
  creadoEn  DateTime  @default(now())

  usuarios  Usuario[]
}

model Trampa {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  direccion String
  location  Json      // ✅ GeoJSON Point: { type: "Point", coordinates: [lng, lat] }
  ubicacion String?
  creadoEn  DateTime  @default(now())

  informes  Informe[]
}


model Informe {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  fecha      DateTime
  tipos      Json      // guarda ["ovi","adultos"] como JSON
  cantidades Json      // { ovi: { Culex: 3 }, adultos: { Aedes: 4 } }
  notas      String?
  creadoEn   DateTime  @default(now())

  trampaId   String    @db.ObjectId
  trampa     Trampa    @relation(fields: [trampaId], references: [id])

  @@unique([trampaId, fecha])   // ✅ evita duplicados en la misma dirección y fecha
}
